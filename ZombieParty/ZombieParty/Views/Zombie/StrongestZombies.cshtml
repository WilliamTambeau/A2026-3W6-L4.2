@model IEnumerable<Zombie>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-12">
            <h2 class="text-primary">Zombie</h2>
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div href="#" class="card  border m-3 text-center bg-warning" style="width: 20rem; background-image: url('/images/imagesLayout/Fond.png'); ">
                <div class="card-body  text-warning">
                    <h3 class="card-title"> @item.Name </h3>
                    <h4 class="card-title text-success"> @item.ZombieType.TypeName </h4>
                    <h5> @item.Point + @item.ZombieType.Point = @(item.ZombieType.Point + item.Point) </h5>
                </div>
            </div>
        }
    </div>
</div>
